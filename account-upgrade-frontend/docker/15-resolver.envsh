#!/bin/sh
# Sourced by the nginx entrypoint before templates are rendered.
# Uses the container's DNS server (Docker: 127.0.0.11, Kubernetes: kube-dns) unless NGINX_RESOLVER is set.
if [ -z "${NGINX_RESOLVER:-}" ]; then
    NGINX_RESOLVER=$(awk '$1 == "nameserver" { print $2; exit }' /etc/resolv.conf)
    export NGINX_RESOLVER="${NGINX_RESOLVER:-127.0.0.11}"
fi
